# Configuración opcional de Docker. Copie este archivo como .env y ajústelo
# ANTES del primer "docker compose up -d".

# Puerto público de la aplicación.
TEATRO_PUERTO=8080

# Clave del usuario teatro_app de MySQL (solo letras, números, puntos y guiones).
# La base no es accesible desde fuera de Docker, pero en producción conviene cambiarla.
TEATRO_DB_PASSWORD=Teatro.App-2026

# Zona horaria de MySQL, que decide qué obras ya pasaron (ej.: -06:00, -05:00, +01:00).
TEATRO_ZONA_HORARIA=-06:00
