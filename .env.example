# Configuración de Docker. La escribe ./instalar.sh, que es la forma recomendada de instalar.
#
# Para configurar a mano un MySQL nuevo en Docker: copie este archivo como .env,
# escriba una clave propia en TEATRO_DB_PASSWORD (por ejemplo, la salida de
# "openssl rand -hex 24") y ejecute: docker compose up -d --build
# Sin clave, docker compose se niega a arrancar.

COMPOSE_FILE=docker-compose.yml:docker/mysql-docker.yml
TEATRO_MODO=docker

# Puerto público. Con 127.0.0.1:8080 solo se accede desde el propio servidor (detrás de un proxy con HTTPS).
TEATRO_PUERTO=8080

# Zona horaria de MySQL, que decide qué obras ya pasaron (ej.: -06:00, -05:00, +01:00).
TEATRO_ZONA_HORARIA=-06:00

# Clave del usuario teatro_app de MySQL (obligatoria; solo letras y números).
TEATRO_DB_PASSWORD=

# Protección contra compras masivas (0 = sin límite): entradas por persona para
# cada obra, compras por IP en una hora y consultas de entradas por IP en 15 minutos.
TEATRO_LIMITE_ENTRADAS_COMPRADOR=4
TEATRO_LIMITE_COMPRAS_IP=20
TEATRO_LIMITE_CONSULTAS_IP=10
